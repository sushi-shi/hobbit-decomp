#!/usr/bin/env python3
"""Enter the Gruntz-derived shell with the pinned local compiler header.

Snapshot the environment definition and complete SP5 header into ignored
build/ so Nix receives stable inputs during parallel compilation.
Use --viewer to add the optional Ghidra viewer; matching is the default.
"""
from pathlib import Path
import os
import hashlib
import json
import shutil
import subprocess
import sys
import tempfile

# Gruntz shell dispatch donor: flake.nix at
# 7d4bd55b99e32f084834d991badf7609889481f4; viewer selection is Hobbit-specific.
arguments = sys.argv[1:]
shell_name = "build"
if arguments[:1] == ["--viewer"]:
    shell_name = "viewer"
    arguments = arguments[1:]

repo = Path(__file__).resolve().parents[1]
build = repo / "build"
build.mkdir(exist_ok=True)
# Per-invocation snapshot prevents parallel workers changing a Nix input while
# Nix hashes it. It is small and automatically removed when the shell exits.
with tempfile.TemporaryDirectory(prefix="nix-shell-", dir=build) as temp:
    snapshot = Path(temp)
    for name in ("flake.nix", "flake.lock"):
        shutil.copy2(repo / name, snapshot / name)
    shutil.copytree(repo / "nix", snapshot / "nix")
    # Complete proprietary toolchain header remains an ignored local input.
    pins = json.loads((repo / "nix/toolchain-identities.json").read_text())
    header_pin = pins["standard_headers"]["XTREE"]
    header = repo / header_pin["local_path"]
    if not header.is_file():
        raise SystemExit("missing SP5 XTREE; install preserved media with scripts/toolchain/install_sp5_xtree.py")
    if hashlib.sha256(header.read_bytes()).hexdigest() != header_pin["sha256"]:
        raise SystemExit("SP5 XTREE differs from the pinned complete original")
    staged_header = snapshot / "private/vc6-sp5/XTREE"
    staged_header.parent.mkdir(parents=True)
    shutil.copyfile(header, staged_header)
    result = subprocess.run(["nix", "develop", f"path:{snapshot}#{shell_name}", *arguments], cwd=repo)
    raise SystemExit(result.returncode)
